type http_request_result = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type http_header = 
 record {
   name: text;
   value: text;
 };
type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type VendorType = 
 variant {
   brand;
   rawMaterial;
 };
type VendorSummary = 
 record {
   address: text;
   approvedAt: opt int;
   assignedProductIds: vec text;
   bankAccountNumber: text;
   brandName: opt text;
   businessName: text;
   categories: vec text;
   contactEmail: text;
   fssaiDocumentUrl: opt text;
   gstinNumber: opt text;
   id: principal;
   ifscCode: text;
   packagingDetails: opt text;
   phone: text;
   registeredAt: int;
   status: VendorStatus;
   vendorType: VendorType;
 };
type VendorStatus = 
 variant {
   approved;
   pending;
   rejected;
   suspended;
 };
type VendorRegistration = 
 record {
   address: text;
   bankAccountNumber: text;
   brandName: opt text;
   businessName: text;
   categories: vec text;
   contactEmail: text;
   fssaiDocumentUrl: opt text;
   gstinNumber: opt text;
   ifscCode: text;
   packagingDetails: opt text;
   phone: text;
   vendorType: VendorType;
 };
type VendorProfile = 
 record {
   address: text;
   approvedAt: opt int;
   assignedProductIds: vec text;
   bankAccountNumber: text;
   brandName: opt text;
   businessName: text;
   categories: vec text;
   contactEmail: text;
   fssaiDocumentUrl: opt text;
   gstinNumber: opt text;
   id: principal;
   ifscCode: text;
   packagingDetails: opt text;
   phone: text;
   registeredAt: int;
   status: VendorStatus;
   vendorType: VendorType;
 };
type VendorProductView = 
 record {
   availableQuantityKg: opt nat;
   basePrice: nat;
   category: text;
   description: text;
   finalPrice: opt nat;
   fssaiDocumentUrl: opt text;
   id: nat;
   imageUrls: vec text;
   moq: opt nat;
   mrp: opt nat;
   packagingCost: opt nat;
   pricePerKg: opt nat;
   productName: text;
   rejectionReason: opt text;
   reviewedAt: opt int;
   status: variant {
             approved;
             pending;
             rejected;
           };
   submittedAt: int;
   supplyPrice: opt nat;
   taxPercent: opt nat;
   vendorEmail: text;
   vendorId: principal;
   vendorName: text;
   vendorType: VendorType;
 };
type VendorProductInput = 
 record {
   availableQuantityKg: opt nat;
   basePrice: nat;
   category: text;
   description: text;
   fssaiDocumentUrl: opt text;
   imageUrls: vec text;
   moq: opt nat;
   mrp: opt nat;
   pricePerKg: opt nat;
   productName: text;
   supplyPrice: opt nat;
   vendorName: text;
   vendorType: VendorType;
 };
type VendorOrderSummary = 
 record {
   orderId: text;
   placedAt: int;
   productId: text;
   productName: text;
   quantity: nat;
   totalPrice: float64;
 };
type UserProfilePublic = 
 record {
   addresses: vec Address;
   createdAt: int;
   email: text;
   id: UserId;
   isAdmin: bool;
   name: text;
   phone: text;
   updatedAt: int;
 };
type UserProfileInput = 
 record {
   email: text;
   name: text;
   phone: text;
 };
type UserId = principal;
type TransformationOutput = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: http_request_result;
 };
type SubCategoryId = nat;
type SubCategory = 
 record {
   id: SubCategoryId;
   imageUrl: text;
   name: text;
 };
type SocialLink = 
 record {
   enabled: bool;
   platform: text;
   url: text;
 };
type ShipmentUpdate = 
 record {
   message: text;
   status: OrderStatus;
   timestamp: int;
 };
type ServiceType = 
 variant {
   Ambulance;
   Doctors;
   EventManagement;
   FoodDelivery;
   FuneralServices;
   Gifting;
   Medicines;
   Other;
   SchoolAdmissions;
   Taxi;
   Tourism;
   VideoConferencing;
   WeddingsAnniversaries;
 };
type ServiceRequestStatus = 
 variant {
   Cancelled;
   Completed;
   Contacted;
   New;
 };
type ServiceRequestPublic = 
 record {
   description: text;
   id: nat;
   isRequestForSelf: bool;
   lastUpdatedAt: int;
   preferredDate: text;
   preferredTime: text;
   recipientAddress: opt text;
   recipientName: opt text;
   recipientPhone: opt text;
   serviceType: ServiceType;
   status: ServiceRequestStatus;
   submittedAt: int;
   userId: text;
   userName: text;
   userPhone: text;
 };
type ProductListResult = 
 record {
   products: vec Product;
   total: nat;
 };
type ProductInput = 
 record {
   brand: text;
   category: CategoryId;
   description: text;
   discountPercent: nat;
   imageUrls: vec text;
   price: nat;
   rating: nat;
   reviewCount: nat;
   stock: nat;
   subCategory: text;
   tags: vec text;
   title: text;
 };
type ProductId = nat;
type ProductFilter = 
 record {
   categoryId: opt CategoryId;
   inStockOnly: bool;
   limit: nat;
   maxPrice: opt nat;
   minPrice: opt nat;
   offset: nat;
   searchTerm: opt text;
 };
type Product = 
 record {
   brand: text;
   category: CategoryId;
   createdAt: int;
   description: text;
   discountPercent: nat;
   id: ProductId;
   imageUrls: vec text;
   isActive: bool;
   price: nat;
   rating: nat;
   reviewCount: nat;
   stock: nat;
   subCategory: text;
   tags: vec text;
   title: text;
   updatedAt: int;
 };
type OrderStatus = 
 variant {
   Cancelled;
   Confirmed;
   Delivered;
   OutForDelivery;
   Processing;
   Shipped;
 };
type OrderPublic = 
 record {
   createdAt: int;
   deliveryAddress: DeliveryAddress;
   deliveryCost: nat;
   deliveryType: DeliveryType;
   estimatedDelivery: opt int;
   id: OrderId;
   items: vec OrderItem;
   paymentMethod: text;
   shipmentUpdates: vec ShipmentUpdate;
   status: OrderStatus;
   totalAmount: nat;
   updatedAt: int;
   userId: principal;
 };
type OrderItem = 
 record {
   discountPercent: nat;
   imageUrl: text;
   price: nat;
   productId: nat;
   quantity: nat;
   title: text;
 };
type OrderId = nat;
type HowItWorksStep = 
 record {
   description: text;
   title: text;
 };
type HeroBannerInput = 
 record {
   ctaSlug: text;
   ctaText: text;
   durationSeconds: nat;
   imageUrl: text;
   isActive: bool;
   order: nat;
   subtitle: text;
   title: text;
 };
type HeroBannerId = nat;
type HeroBanner = 
 record {
   ctaSlug: text;
   ctaText: text;
   durationSeconds: nat;
   id: HeroBannerId;
   imageUrl: text;
   isActive: bool;
   order: nat;
   subtitle: text;
   title: text;
 };
type FeaturedBlockInput = 
 record {
   content: text;
   contentImages: vec text;
   isActive: bool;
   order: nat;
   thumbnailUrl: text;
   title: text;
 };
type FeaturedBlockId = nat;
type FeaturedBlock = 
 record {
   content: text;
   contentImages: vec text;
   createdAt: int;
   id: FeaturedBlockId;
   isActive: bool;
   order: nat;
   thumbnailUrl: text;
   title: text;
 };
type DeliveryType = 
 variant {
   Express;
   Standard;
 };
type DeliveryAddress = 
 record {
   city: text;
   district: text;
   houseNo: text;
   landmark: text;
   locality: text;
   name: text;
   phone: text;
   pincode: text;
   state: text;
   street: text;
 };
type CustomerReviewId = nat;
type CustomerReview = 
 record {
   createdAt: int;
   id: CustomerReviewId;
   productName: text;
   rating: nat;
   reviewText: text;
   reviewerName: text;
 };
type CreateServiceRequestInput = 
 record {
   description: text;
   isRequestForSelf: bool;
   preferredDate: text;
   preferredTime: text;
   recipientAddress: opt text;
   recipientName: opt text;
   recipientPhone: opt text;
   serviceType: ServiceType;
   userName: text;
   userPhone: text;
 };
type CreateOrderInput = 
 record {
   deliveryAddress: DeliveryAddress;
   deliveryCost: nat;
   deliveryType: DeliveryType;
   items: vec record {
                productId: nat;
                quantity: nat;
              };
   paymentMethod: text;
 };
type CategoryId = nat;
type Category = 
 record {
   description: text;
   id: CategoryId;
   imageUrl: text;
   name: text;
   slug: text;
   subCategories: vec SubCategory;
 };
type CartPublic = 
 record {
   items: vec CartItem;
   updatedAt: int;
   userId: principal;
 };
type CartItem = 
 record {
   addedAt: int;
   productId: nat;
   quantity: nat;
 };
type Address = 
 record {
   city: text;
   isDefault: bool;
   line1: text;
   line2: text;
   name: text;
   phone: text;
   pincode: text;
   state: text;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  addMyAddress: (address: Address) -> (UserProfilePublic);
  addToCart: (productId: nat, quantity: nat) -> (CartPublic);
  adminAddCategory: (adminToken: text, name: text, slug: text, description:
   text, imageUrl: text) -> (variant {
                               err: text;
                               ok: Category;
                             });
  adminAddFeaturedBlock: (adminToken: text, input: FeaturedBlockInput) ->
   (FeaturedBlock);
  adminAddHeroBanner: (adminToken: text, input: HeroBannerInput) ->
   (HeroBanner);
  adminAddProduct: (adminToken: text, input: ProductInput) -> (Product);
  adminAddReview: (adminToken: text, reviewerName: text, rating: nat,
   reviewText: text, productName: text) -> (nat);
  adminAddSubCategory: (adminToken: text, categoryId: CategoryId, name: 
   text, imageUrl: text) -> (variant {
                               err: text;
                               ok: Category;
                             });
  adminApproveVendor: (adminToken: text, vendorId: principal) ->
   (variant {
      err: text;
      ok;
    });
  adminApproveVendorProduct: (adminToken: text, productId: nat, taxPercent:
   nat, packagingCost: opt nat) ->
   (variant {
      err: text;
      ok: VendorProductView;
    });
  adminAssignProductToVendor: (adminToken: text, vendorId: principal,
   productId: text) -> (variant {
                          err: text;
                          ok;
                        });
  adminDeleteCategory: (adminToken: text, id: CategoryId) ->
   (variant {
      err: text;
      ok: bool;
    });
  adminDeleteFeaturedBlock: (adminToken: text, id: FeaturedBlockId) ->
   (variant {
      err: text;
      ok: bool;
    });
  adminDeleteHeroBanner: (adminToken: text, id: HeroBannerId) ->
   (variant {
      err: text;
      ok: bool;
    });
  adminDeleteProduct: (adminToken: text, id: ProductId) -> (bool);
  adminDeleteReview: (adminToken: text, id: nat) -> (bool);
  adminDeleteServiceRequest: (adminToken: text, id: nat) -> (bool);
  adminDeleteSubCategory: (adminToken: text, categoryId: CategoryId,
   subCategoryId: SubCategoryId) -> (variant {
                                       err: text;
                                       ok: Category;
                                     });
  adminGetAllOrders: (limit: nat, offset: nat) -> (vec OrderPublic) query;
  adminGetCategories: (adminToken: text) -> (vec Category) query;
  adminGetServiceRequests: (adminToken: text) ->
   (vec ServiceRequestPublic) query;
  adminListFeaturedBlocks: (adminToken: text) -> (vec FeaturedBlock) query;
  adminListHeroBanners: (adminToken: text) -> (vec HeroBanner) query;
  adminListVendorProducts: (adminToken: text) ->
   (vec VendorProductView) query;
  adminListVendorProductsByVendor: (adminToken: text, vendorId: principal) ->
   (vec VendorProductView) query;
  adminListVendors: (status: opt VendorStatus) -> (vec VendorSummary) query;
  adminLogin: (userId: text, passcode: text) -> (opt text);
  adminLogout: (token: text) -> ();
  adminRegisterImageHash: (adminToken: text, hash: text) -> (text);
  adminRejectVendor: (adminToken: text, vendorId: principal, reason: 
   text) -> (variant {
               err: text;
               ok;
             });
  adminRejectVendorProduct: (adminToken: text, productId: nat, reason:
   text) -> (variant {
               err: text;
               ok: VendorProductView;
             });
  adminReorderHeroBanner: (adminToken: text, id: HeroBannerId, newOrder:
   nat) -> (variant {
              err: text;
              ok: HeroBanner;
            });
  adminRequestOtp: () -> (variant {
                            err: text;
                            ok;
                          });
  adminSetDiscount: (adminToken: text, id: ProductId, discountPercent:
   nat) -> (opt Product);
  adminSetUserAdmin: (targetUser: principal, adminStatus: bool) -> (bool);
  adminSuspendVendor: (adminToken: text, vendorId: principal) ->
   (variant {
      err: text;
      ok;
    });
  adminUnassignProductFromVendor: (adminToken: text, vendorId: principal,
   productId: text) -> (variant {
                          err: text;
                          ok;
                        });
  adminUpdateCategory: (adminToken: text, id: CategoryId, name: text, slug:
   text, description: text, imageUrl: text) ->
   (variant {
      err: text;
      ok: Category;
    });
  adminUpdateFeaturedBlock: (adminToken: text, id: FeaturedBlockId, input:
   FeaturedBlockInput) -> (variant {
                             err: text;
                             ok: FeaturedBlock;
                           });
  adminUpdateFooterSettings: (adminToken: text, tagline: text, copyright:
   text, aboutContent: text, socialLinks: vec SocialLink) -> (bool);
  adminUpdateHeroAndHowitworks: (adminToken: text, heroTagline: text,
   heroSubtitle: text, howitworksSteps: vec HowItWorksStep) -> ();
  adminUpdateHeroBanner: (adminToken: text, id: HeroBannerId, input:
   HeroBannerInput) -> (variant {
                          err: text;
                          ok: HeroBanner;
                        });
  adminUpdateOrderStatus: (orderId: OrderId, newStatus: OrderStatus, message:
   text) -> (opt OrderPublic);
  adminUpdatePolicyContent: (adminToken: text, policyContent: text) -> (bool);
  adminUpdateProduct: (adminToken: text, id: ProductId, input:
   ProductInput) -> (opt Product);
  adminUpdateReview: (adminToken: text, id: nat, reviewerName: text, rating:
   nat, reviewText: text, productName: text) -> (bool);
  adminUpdateServiceRequestStatus: (adminToken: text, id: nat, status:
   ServiceRequestStatus) -> (opt ServiceRequestPublic);
  adminUpdateServicesAvailability: (adminToken: text, available: bool,
   message: text) -> ();
  adminUpdateSiteSettings: (adminToken: text, logoUrl: opt text, faviconUrl:
   opt text) -> (record {
                   faviconUrl: opt text;
                   logoUrl: opt text;
                 });
  adminUpdateStock: (adminToken: text, id: ProductId, newStock: nat) ->
   (opt Product);
  adminUpdateSubCategory: (adminToken: text, categoryId: CategoryId,
   subCategoryId: SubCategoryId, name: text, imageUrl: text) ->
   (variant {
      err: text;
      ok: Category;
    });
  adminUpdateVendorProductQuantity: (adminToken: text, productId: nat,
   newQuantityKg: nat) -> (variant {
                             err: text;
                             ok;
                           });
  adminUpdateVideoByte: (adminToken: text, url: text, enabled: bool, title:
   text) -> ();
  adminVerifyKey: (secretKey: text) -> (variant {
                                          err: text;
                                          ok;
                                        });
  adminVerifyOtp: (code: text) -> (variant {
                                     err: text;
                                     ok: text;
                                   });
  claimAdminIfFirst: () -> (bool);
  clearMyCart: () -> ();
  createOrder: (input: CreateOrderInput) -> (OrderPublic);
  createRazorpayOrder: (amount: nat, receipt: text) ->
   (variant {
      err: text;
      ok: record {
            amount: nat;
            currency: text;
            orderId: text;
          };
    });
  getCategory: (id: CategoryId) -> (opt Category) query;
  getCategoryBySlug: (slug: text) -> (opt Category) query;
  getFeaturedBlock: (id: FeaturedBlockId) -> (opt FeaturedBlock) query;
  getFooterSettings: () ->
   (record {
      aboutContent: text;
      copyright: text;
      policyContent: text;
      socialLinks: vec SocialLink;
      tagline: text;
    }) query;
  getHeroBanner: (id: HeroBannerId) -> (opt HeroBanner) query;
  getMyCart: () -> (CartPublic);
  getMyOrders: () -> (vec OrderPublic) query;
  getMyProfile: () -> (UserProfilePublic);
  getMyVendorOrders: () -> (vec VendorOrderSummary) query;
  getMyVendorProfile: () -> (variant {
                               err: text;
                               ok: VendorProfile;
                             }) query;
  getOrder: (orderId: OrderId) -> (opt OrderPublic) query;
  getProduct: (id: ProductId) -> (opt Product) query;
  getReviews: () -> (vec CustomerReview) query;
  getServicesAvailability: () ->
   (record {
      available: bool;
      message: text;
    }) query;
  getSiteSettings: () ->
   (record {
      faviconUrl: opt text;
      heroSubtitle: text;
      heroTagline: text;
      howitworksSteps: vec HowItWorksStep;
      logoUrl: opt text;
    }) query;
  getVendorForProduct: (productId: text) -> (opt VendorSummary) query;
  getVendorStatusBySession: (token: text) -> (opt VendorStatus) query;
  getVideoByte: () -> (record {
                         enabled: bool;
                         title: text;
                         url: text;
                       }) query;
  isAdminSession: (token: text) -> (bool) query;
  isCurrentUserAdmin: () -> (bool) query;
  listBestSellers: (limit: nat) -> (vec Product) query;
  listCategories: () -> (vec Category) query;
  listFeaturedBlocks: () -> (vec FeaturedBlock) query;
  listHeroBanners: () -> (vec HeroBanner) query;
  listNewArrivals: (limit: nat) -> (vec Product) query;
  listProducts: (filter: ProductFilter) -> (ProductListResult) query;
  listProductsByCategory: (categoryId: CategoryId, limit: nat, offset:
   nat) -> (ProductListResult) query;
  processVendorActionToken: (token: text, action:
   variant {
     approve;
     reject;
   }) -> (variant {
            err: text;
            ok: text;
          });
  razorpayTransform: (input: TransformationInput) ->
   (TransformationOutput) query;
  registerVendor: (details: VendorRegistration) ->
   (variant {
      err: text;
      ok: text;
    });
  removeFromCart: (productId: nat) -> (CartPublic);
  requestOtp: (email: text) -> (variant {
                                  err: text;
                                  ok;
                                });
  searchProducts: (term: text, limit: nat, offset: nat) ->
   (ProductListResult) query;
  submitServiceRequest: (input: CreateServiceRequestInput) ->
   (ServiceRequestPublic);
  updateCartItem: (productId: nat, quantity: nat) -> (CartPublic);
  updateMyProfile: (input: UserProfileInput) -> (UserProfilePublic);
  vendorGetMyProducts: (sessionToken: text) ->
   (variant {
      err: text;
      ok: vec VendorProductView;
    });
  vendorSubmitProduct: (sessionToken: text, input: VendorProductInput) ->
   (variant {
      err: text;
      ok: VendorProductView;
    });
  vendorUpdateProductQuantity: (sessionToken: text, productId: nat,
   newQuantityKg: nat) -> (variant {
                             err: text;
                             ok;
                           });
  verifyOtp: (email: text, code: text) -> (variant {
                                             err: text;
                                             ok: text;
                                           });
  verifyRazorpayPayment: (razorpayOrderId: text, razorpayPaymentId: text,
   razorpaySignature: text) -> (variant {
                                  err: text;
                                  ok: bool;
                                });
  verifyVendorOtp: (email: text, code: text) ->
   (variant {
      err: text;
      ok: record {
            status: VendorStatus;
            token: text;
          };
    });
}
