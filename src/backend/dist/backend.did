type http_request_result = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type http_header = 
 record {
   name: text;
   value: text;
 };
type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type UserProfilePublic = 
 record {
   addresses: vec Address;
   createdAt: int;
   email: text;
   id: UserId;
   isAdmin: bool;
   name: text;
   phone: text;
   updatedAt: int;
 };
type UserProfileInput = 
 record {
   email: text;
   name: text;
   phone: text;
 };
type UserId = principal;
type TransformationOutput = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: http_request_result;
 };
type SubCategoryId = nat;
type SubCategory = 
 record {
   id: SubCategoryId;
   imageUrl: text;
   name: text;
 };
type ShipmentUpdate = 
 record {
   message: text;
   status: OrderStatus;
   timestamp: int;
 };
type ServiceType = 
 variant {
   Ambulance;
   Doctors;
   EventManagement;
   FoodDelivery;
   FuneralServices;
   Gifting;
   Medicines;
   Other;
   SchoolAdmissions;
   Taxi;
   Tourism;
   VideoConferencing;
   WeddingsAnniversaries;
 };
type ServiceRequestStatus = 
 variant {
   Cancelled;
   Completed;
   Contacted;
   New;
 };
type ServiceRequestPublic = 
 record {
   description: text;
   id: nat;
   isRequestForSelf: bool;
   lastUpdatedAt: int;
   preferredDate: text;
   preferredTime: text;
   recipientAddress: opt text;
   recipientName: opt text;
   recipientPhone: opt text;
   serviceType: ServiceType;
   status: ServiceRequestStatus;
   submittedAt: int;
   userId: text;
   userName: text;
   userPhone: text;
 };
type ProductListResult = 
 record {
   products: vec Product;
   total: nat;
 };
type ProductInput = 
 record {
   brand: text;
   category: CategoryId;
   description: text;
   discountPercent: nat;
   imageUrls: vec text;
   price: nat;
   rating: nat;
   reviewCount: nat;
   stock: nat;
   subCategory: text;
   tags: vec text;
   title: text;
 };
type ProductId = nat;
type ProductFilter = 
 record {
   categoryId: opt CategoryId;
   inStockOnly: bool;
   limit: nat;
   maxPrice: opt nat;
   minPrice: opt nat;
   offset: nat;
   searchTerm: opt text;
 };
type Product = 
 record {
   brand: text;
   category: CategoryId;
   createdAt: int;
   description: text;
   discountPercent: nat;
   id: ProductId;
   imageUrls: vec text;
   isActive: bool;
   price: nat;
   rating: nat;
   reviewCount: nat;
   stock: nat;
   subCategory: text;
   tags: vec text;
   title: text;
   updatedAt: int;
 };
type OrderStatus = 
 variant {
   Cancelled;
   Confirmed;
   Delivered;
   OutForDelivery;
   Processing;
   Shipped;
 };
type OrderPublic = 
 record {
   createdAt: int;
   deliveryAddress: DeliveryAddress;
   deliveryCost: nat;
   deliveryType: DeliveryType;
   estimatedDelivery: opt int;
   id: OrderId;
   items: vec OrderItem;
   paymentMethod: text;
   shipmentUpdates: vec ShipmentUpdate;
   status: OrderStatus;
   totalAmount: nat;
   updatedAt: int;
   userId: principal;
 };
type OrderItem = 
 record {
   discountPercent: nat;
   imageUrl: text;
   price: nat;
   productId: nat;
   quantity: nat;
   title: text;
 };
type OrderId = nat;
type HeroBannerInput = 
 record {
   ctaSlug: text;
   ctaText: text;
   imageUrl: text;
   isActive: bool;
   order: nat;
   subtitle: text;
   title: text;
 };
type HeroBannerId = nat;
type HeroBanner = 
 record {
   ctaSlug: text;
   ctaText: text;
   id: HeroBannerId;
   imageUrl: text;
   isActive: bool;
   order: nat;
   subtitle: text;
   title: text;
 };
type FeaturedBlockInput = 
 record {
   content: text;
   contentImages: vec text;
   isActive: bool;
   order: nat;
   thumbnailUrl: text;
   title: text;
 };
type FeaturedBlockId = nat;
type FeaturedBlock = 
 record {
   content: text;
   contentImages: vec text;
   createdAt: int;
   id: FeaturedBlockId;
   isActive: bool;
   order: nat;
   thumbnailUrl: text;
   title: text;
 };
type DeliveryType = 
 variant {
   Express;
   Standard;
 };
type DeliveryAddress = 
 record {
   city: text;
   district: text;
   houseNo: text;
   landmark: text;
   locality: text;
   name: text;
   phone: text;
   pincode: text;
   state: text;
   street: text;
 };
type CreateServiceRequestInput = 
 record {
   description: text;
   isRequestForSelf: bool;
   preferredDate: text;
   preferredTime: text;
   recipientAddress: opt text;
   recipientName: opt text;
   recipientPhone: opt text;
   serviceType: ServiceType;
   userName: text;
   userPhone: text;
 };
type CreateOrderInput = 
 record {
   deliveryAddress: DeliveryAddress;
   deliveryCost: nat;
   deliveryType: DeliveryType;
   items: vec record {
                productId: nat;
                quantity: nat;
              };
   paymentMethod: text;
 };
type CategoryId = nat;
type Category = 
 record {
   description: text;
   id: CategoryId;
   imageUrl: text;
   name: text;
   slug: text;
   subCategories: vec SubCategory;
 };
type CartPublic = 
 record {
   items: vec CartItem;
   updatedAt: int;
   userId: principal;
 };
type CartItem = 
 record {
   addedAt: int;
   productId: nat;
   quantity: nat;
 };
type Address = 
 record {
   city: text;
   isDefault: bool;
   line1: text;
   line2: text;
   name: text;
   phone: text;
   pincode: text;
   state: text;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  addMyAddress: (address: Address) -> (UserProfilePublic);
  addToCart: (productId: nat, quantity: nat) -> (CartPublic);
  adminAddCategory: (name: text, slug: text, description: text, imageUrl:
   text) -> (variant {
               err: text;
               ok: Category;
             });
  adminAddFeaturedBlock: (input: FeaturedBlockInput) -> (FeaturedBlock);
  adminAddHeroBanner: (input: HeroBannerInput) -> (HeroBanner);
  adminAddProduct: (input: ProductInput) -> (Product);
  adminAddSubCategory: (categoryId: CategoryId, name: text, imageUrl:
   text) -> (variant {
               err: text;
               ok: Category;
             });
  adminDeleteCategory: (id: CategoryId) -> (variant {
                                              err: text;
                                              ok: bool;
                                            });
  adminDeleteFeaturedBlock: (id: FeaturedBlockId) ->
   (variant {
      err: text;
      ok: bool;
    });
  adminDeleteHeroBanner: (id: HeroBannerId) ->
   (variant {
      err: text;
      ok: bool;
    });
  adminDeleteProduct: (id: ProductId) -> (bool);
  adminDeleteServiceRequest: (id: nat) -> (bool);
  adminDeleteSubCategory: (categoryId: CategoryId, subCategoryId:
   SubCategoryId) -> (variant {
                        err: text;
                        ok: Category;
                      });
  adminGetAllOrders: (limit: nat, offset: nat) -> (vec OrderPublic) query;
  adminGetCategories: () -> (vec Category) query;
  adminGetServiceRequests: () -> (vec ServiceRequestPublic) query;
  adminListFeaturedBlocks: () -> (vec FeaturedBlock) query;
  adminListHeroBanners: () -> (vec HeroBanner) query;
  adminLogin: (userId: text, passcode: text) -> (opt text);
  adminLogout: (token: text) -> ();
  adminRegisterImageHash: (hash: text) -> (text);
  adminReorderHeroBanner: (id: HeroBannerId, newOrder: nat) ->
   (variant {
      err: text;
      ok: HeroBanner;
    });
  adminSetDiscount: (id: ProductId, discountPercent: nat) -> (opt Product);
  adminSetUserAdmin: (targetUser: principal, adminStatus: bool) -> (bool);
  adminUpdateCategory: (id: CategoryId, name: text, slug: text, description:
   text, imageUrl: text) -> (variant {
                               err: text;
                               ok: Category;
                             });
  adminUpdateFeaturedBlock: (id: FeaturedBlockId, input:
   FeaturedBlockInput) -> (variant {
                             err: text;
                             ok: FeaturedBlock;
                           });
  adminUpdateHeroBanner: (id: HeroBannerId, input: HeroBannerInput) ->
   (variant {
      err: text;
      ok: HeroBanner;
    });
  adminUpdateOrderStatus: (orderId: OrderId, newStatus: OrderStatus, message:
   text) -> (opt OrderPublic);
  adminUpdateProduct: (id: ProductId, input: ProductInput) -> (opt Product);
  adminUpdateServiceRequestStatus: (id: nat, status: ServiceRequestStatus) ->
   (opt ServiceRequestPublic);
  adminUpdateServicesAvailability: (available: bool, message: text) -> ();
  adminUpdateSiteSettings: (logoUrl: opt text, faviconUrl: opt text) ->
   (record {
      faviconUrl: opt text;
      logoUrl: opt text;
    });
  adminUpdateStock: (id: ProductId, newStock: nat) -> (opt Product);
  adminUpdateSubCategory: (categoryId: CategoryId, subCategoryId:
   SubCategoryId, name: text, imageUrl: text) ->
   (variant {
      err: text;
      ok: Category;
    });
  adminUpdateVideoByte: (url: text, enabled: bool, title: text) -> ();
  claimAdminIfFirst: () -> (bool);
  clearMyCart: () -> ();
  createOrder: (input: CreateOrderInput) -> (OrderPublic);
  createRazorpayOrder: (amount: nat, receipt: text) ->
   (variant {
      err: text;
      ok: record {
            amount: nat;
            currency: text;
            orderId: text;
          };
    });
  getCategory: (id: CategoryId) -> (opt Category) query;
  getCategoryBySlug: (slug: text) -> (opt Category) query;
  getFeaturedBlock: (id: FeaturedBlockId) -> (opt FeaturedBlock) query;
  getHeroBanner: (id: HeroBannerId) -> (opt HeroBanner) query;
  getMyCart: () -> (CartPublic);
  getMyOrders: () -> (vec OrderPublic) query;
  getMyProfile: () -> (UserProfilePublic);
  getOrder: (orderId: OrderId) -> (opt OrderPublic) query;
  getProduct: (id: ProductId) -> (opt Product) query;
  getServicesAvailability: () ->
   (record {
      available: bool;
      message: text;
    }) query;
  getSiteSettings: () ->
   (record {
      faviconUrl: opt text;
      logoUrl: opt text;
    }) query;
  getVideoByte: () -> (record {
                         enabled: bool;
                         title: text;
                         url: text;
                       }) query;
  isAdminSession: (token: text) -> (bool) query;
  isCurrentUserAdmin: () -> (bool) query;
  listCategories: () -> (vec Category) query;
  listFeaturedBlocks: () -> (vec FeaturedBlock) query;
  listHeroBanners: () -> (vec HeroBanner) query;
  listProducts: (filter: ProductFilter) -> (ProductListResult) query;
  listProductsByCategory: (categoryId: CategoryId, limit: nat, offset:
   nat) -> (ProductListResult) query;
  razorpayTransform: (input: TransformationInput) ->
   (TransformationOutput) query;
  removeFromCart: (productId: nat) -> (CartPublic);
  searchProducts: (term: text, limit: nat, offset: nat) ->
   (ProductListResult) query;
  submitServiceRequest: (input: CreateServiceRequestInput) ->
   (ServiceRequestPublic);
  updateCartItem: (productId: nat, quantity: nat) -> (CartPublic);
  updateMyProfile: (input: UserProfileInput) -> (UserProfilePublic);
  verifyRazorpayPayment: (razorpayOrderId: text, razorpayPaymentId: text,
   razorpaySignature: text) -> (variant {
                                  err: text;
                                  ok: bool;
                                });
}
